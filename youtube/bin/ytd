#!/bin/sh

OUTPATH=~/Movies/yt
SUB_OPTS="--sub-langs en --write-subs --write-auto-subs --embed-subs --convert-subs srt"

mkdir -p $OUTPATH 2>>/dev/null
yt-dlp -t mp4 -f "bv*[height<=1080][vcodec^=avc1]+ba/bv*[height<=1080][vcodec^=hev1]+ba/bv*[height<=1080]+ba/b[height<=1080]" $SUB_OPTS --sponsorblock-remove sponsor,selfpromo,interaction --mark-watched --live-from-start --wait-for-video 30 --embed-metadata --output "$OUTPATH/%(uploader)s/%(upload_date)s_%(title)s-%(id)s.%(ext)s" --download-archive "~/.vimwiki/logged/youtube_watched.txt" --exec 'mpv --pause {} &' "$@"
